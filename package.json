{
  "name": "@twinwrite/xiaofenshen-mcp-server",
  "version": "0.1.0",
  "description": "小分身开放 MCP：中文热点、网页/微信正文抓取、自然表达校验与公开产品资产",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwinWrite/xiaofenshen-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/TwinWrite/xiaofenshen-mcp-server/issues"
  },
  "homepage": "https://github.com/TwinWrite/xiaofenshen-mcp-server#readme",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "xiaofenshen-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "turndown": "^7.2.4",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
